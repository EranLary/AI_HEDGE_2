DEEPSEEK_API_KEY=

ANALYSIS_WORKERS=4
LLM_WORKERS=3
VALUATION_BLOCK_WORKERS=3

# Neon Postgres
# DATABASE_URL          -- pooled (Next.js / serverless): host ends with -pooler.neon.tech
# DATABASE_URL_UNPOOLED -- unpooled (Python CLI / psycopg with prepared statements)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# IBKR Paper trading control plane. Broker login and 2FA never belong here;
# they stay inside IB Gateway on the executor VM.
TRADING_CONTROL_ENABLED=0
IBKR_LIVE_TRADING_ENABLED=0
TRADING_ACCOUNT_FINGERPRINT_KEY=
TRADING_MONITOR_TOKEN=
TRADING_TELEGRAM_BOT_TOKEN=
TRADING_TELEGRAM_CHAT_ID=

# Site auth (Next.js / Auth.js v5). Set these in frontend/.env.local for dev
# and as Fly secrets for the hedge-in-a-box-site app for prod.
# AUTH_SECRET            -- openssl rand -base64 32
# AUTH_GOOGLE_ID/SECRET  -- from a Google Cloud OAuth 2.0 Web Client
# AUTH_URL               -- canonical site URL in prod (e.g. https://hedge-in-a-box.com); auto-detected in dev
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=

# Nasdaq 100 universe-run admin controls. Defaults to the initial administrator
# configured in code and uses AUTH_SECRET for the short-lived authorization cookie.
# Override the password with a SHA-256 hex digest only; never store plaintext here.
NASDAQ_ADMIN_EMAILS=
NASDAQ_RUN_PASSWORD_SHA256=
NASDAQ_RUN_AUTH_SECRET=

# Nasdaq worker-pool execution. Keep NASDAQ_WORKER_URL empty for the legacy
# same-machine fallback (which defaults to one ticker at a time). Production
# should point it at the dedicated Fly worker and use the same random token on
# both apps. The budget is a conservative planned-attempt guard; observed LLM
# cost is recorded separately when observability is available.
NASDAQ_WORKER_URL=
NASDAQ_WORKER_TOKEN=
NASDAQ_RUN_CONCURRENCY=6
NASDAQ_ESTIMATED_COST_PER_ATTEMPT_USD=2
NASDAQ_RUN_BUDGET_USD=600
NASDAQ_ENFORCE_EXECUTION_WINDOW=1
NASDAQ_TICKER_TIMEOUT_SECONDS=7200

# S3-compatible Cloudflare R2 artifact storage. Required by the dedicated
# worker because it does not share the site's Fly volume.
ARTIFACT_STORE=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Standalone observability app (frontend-obs, deployed as hedge-in-a-box-obs at
# observability.hedge-in-a-box.com). The admin allowlist lives in the
# obs_admins DB table — admins manage it from the /users page; no env list.
# AUTH_GOOGLE_ID/SECRET are reused from the site OAuth client. AUTH_SECRET
# must be a separate value from the site so the cookie blast radii stay isolated.
# Set AUTH_URL=https://observability.hedge-in-a-box.com in prod.

# Dedicated Neon project for the obs platform (obs_runs / obs_calls / obs_admins).
# Falls back to DATABASE_URL_UNPOOLED then DATABASE_URL if unset.
OBS_DATABASE_URL=
