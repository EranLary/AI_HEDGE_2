FROM node:20-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHON_EXECUTABLE=python3 \
    PORT=8080

WORKDIR /app

# Python + system libs required by valuation/PDF stack (WeasyPrint + Matplotlib).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    build-essential \
    ca-certificates \
    fonts-dejavu-core \
    libcairo2-dev \
    libffi8 \
    libgdk-pixbuf-2.0-dev \
    libjpeg62-turbo \
    libpango1.0-dev \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libpng16-16 \
    pkg-config \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN python3 -m pip install --break-system-packages --upgrade pip && python3 -m pip install --break-system-packages -r /app/requirements.txt

COPY frontend/package*.json /app/frontend/
WORKDIR /app/frontend
RUN npm ci

WORKDIR /app
COPY . /app

WORKDIR /app/frontend
RUN npm run build

EXPOSE 8080

# Persist outputs/logs on Fly volume mounted at /data.
CMD ["sh", "-c", "mkdir -p /data/outputs /data/logs && rm -rf /app/outputs /app/logs && ln -s /data/outputs /app/outputs && ln -s /data/logs /app/logs && exec npm run start -- --hostname 0.0.0.0 --port ${PORT:-8080}"]
